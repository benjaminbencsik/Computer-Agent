<?xml version="1.0" encoding="utf-8"?>
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap rescap">

  <!--
    Publisher MUST exactly match the Subject of the code-signing certificate used to
    sign this package (see packaging/build_msix.ps1). The placeholder below will not
    verify against any real certificate -- replace it with your own certificate's
    Subject before signing, e.g. "CN=Your Company, O=Your Company, C=US".
  -->
  <Identity
      Name="BenBencsik.ComputerAgent"
      Publisher="CN=REPLACE_WITH_YOUR_CODESIGNING_CERT_SUBJECT"
      Version="0.3.2.0" />

  <Properties>
    <DisplayName>Computer Agent</DisplayName>
    <PublisherDisplayName>Ben Bencsik</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="ComputerAgent" Executable="ComputerAgent.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="Computer Agent"
          Description="A permission-gated Windows desktop agent with local and cloud model support"
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
